# --- Emergency access (SettingsForm, RescueForm) ---

msgid "Emergency access"
msgstr "Аварийный доступ"

msgid "Protection against accidental self-lockout (for example, when whitelist mode blocks your own IP or region)."
msgstr "Защита от случайной потери доступа (например, когда режим белого списка блокирует ваш собственный IP или область)."

msgid "Never block administrators"
msgstr "Никогда не блокировать администраторов"

msgid "Logged-in user #1, users with the \"administrator\" role and holders of the \"Bypass IP Anti Spam blocking\" permission are never blocked by any rule. Recommended: keep enabled."
msgstr "Пользователь №1 под логином, пользователи с ролью «administrator» и обладатели права «Обход блокировки IP Anti Spam» никогда не блокируются никакими правилами. Рекомендуется держать включённым."

msgid "Emergency URL"
msgstr "Аварийный URL"

msgid "<a href=\":url\"><code>:url</code></a> works from ANY IP — even a blocked one. It disables blocking and adds the visitor IP to the trusted exceptions. Save this URL somewhere safe (password manager)."
msgstr "<a href=\":url\"><code>:url</code></a> работает с ЛЮБОГО IP — даже заблокированного. Отключает блокировку и добавляет IP посетителя в доверенные исключения. Сохраните этот URL в надёжном месте (менеджер паролей)."

msgid "Regenerate rescue token"
msgstr "Перегенерировать токен спасения"

msgid "Use if the emergency URL was compromised. The old URL will stop working."
msgstr "Используйте, если аварийный URL попал в чужие руки. Старый URL перестанет работать."

msgid "The rescue token has been changed. The new emergency URL is <a href=\":url\">:url</a> — save it somewhere safe."
msgstr "Токен спасения изменён. Новый аварийный URL: <a href=\":url\">:url</a> — сохраните его в надёжном месте."

msgid "Invalid or missing rescue token. Ask the site administrator for the emergency URL (Admin → IP Anti Spam → Settings → Emergency access)."
msgstr "Неверный или отсутствующий токен спасения. Запросите у администратора аварийный URL (Админ → IP Anti Spam → Настройки → Аварийный доступ)."

msgid "Blocking is currently ENABLED. Submitting the form below will restore your access."
msgstr "Блокировка сейчас ВКЛЮЧЕНА. Отправка формы ниже вернёт вам доступ."

msgid "Blocking is currently disabled. You can still add your current IP to the trusted exceptions."
msgstr "Блокировка сейчас отключена. Вы всё равно можете добавить свой текущий IP в доверенные исключения."

msgid "Restore my access"
msgstr "Вернуть мне доступ"

msgid "Emergency unblock (@date)"
msgstr "Аварийная разблокировка (@date)"

msgid "Access restored. Blocking is disabled and your IP %ip has been added to the trusted exceptions. Review your rules at @link before enabling blocking again."
msgstr "Доступ восстановлен. Блокировка отключена, ваш IP %ip добавлен в доверенные исключения. Проверьте правила по ссылке @link перед повторным включением блокировки."

# --- GeoIP database download sources (SettingsForm, GeoDbDownloader) ---

msgid "Download source"
msgstr "Источник загрузки"

msgid "The official MaxMind download requires a free license key. Mirrors (P3TERX, jsDelivr, DB-IP Lite) serve the same GeoLite2/compatible City database in .mmdb format and need no registration — use them when the key is not available or download.maxmind.com is unreachable."
msgstr "Официальная загрузка MaxMind требует бесплатного лицензионного ключа. Зеркала (P3TERX, jsDelivr, DB-IP Lite) отдают ту же базу City (GeoLite2 или совместимую) в формате .mmdb и не требуют регистрации — используйте их, если ключа нет или download.maxmind.com недоступен."

msgid "Custom download URL"
msgstr "Произвольный URL загрузки"

msgid "Direct http(s) URL to a .mmdb or gzipped .mmdb.gz file (own mirror, self-hosted copy). Used only when the source is \"Custom URL\"."
msgstr "Прямой http(s) URL файла .mmdb или .mmdb.gz (своё зеркало, копия на своём хостинге). Используется только если выбран источник «Произвольный URL»."

msgid "Download database now"
msgstr "Скачать базу сейчас"

msgid "Downloads the City database from the selected source, validates it and installs it to the path above. Takes up to a few minutes — the Drush command <code>drush yu-ipas:download-db</code> is the preferred way on production."
msgstr "Скачивает базу City из выбранного источника, проверяет её и устанавливает по указанному выше пути. Может занять несколько минут — на продакшене предпочтительнее команда <code>drush yu-ipas:download-db</code>."

msgid "Invalid download source."
msgstr "Недопустимый источник загрузки."

msgid "Provide a direct http(s) URL to a .mmdb or .mmdb.gz file."
msgstr "Укажите прямой http(s) URL файла .mmdb или .mmdb.gz."

msgid "Geo database from @label installed at @path."
msgstr "База @label установлена: @path."

msgid "No MaxMind license key. Pass --key, set yu_ipas.settings:maxmind_key, the MAXMIND_LICENSE_KEY environment variable — or switch to a mirror source that does not require registration."
msgstr "Отсутствует лицензионный ключ MaxMind. Передайте --key, задайте yu_ipas.settings:maxmind_key или переменную окружения MAXMIND_LICENSE_KEY — либо переключитесь на зеркало, не требующее регистрации."

msgid "Unknown source \"@source\". Available: @list"
msgstr "Неизвестный источник «@source». Доступны: @list"

msgid "@label: GeoLite2-City installed at @dest."
msgstr "@label: GeoLite2-City установлена: @dest."

msgid "Downloaded from @url"
msgstr "Скачано с @url"
