msgid "Exception type"
msgstr "Тип исключения"

msgid "CIDR range"
msgstr "CIDR-диапазон"

msgid "User-Agent substring (bots, SEO services)"
msgstr "Подстрока User-Agent (боты, SEO-сервисы)"

