msgid "allowed"
msgstr "разрешены"

msgid "blocked"
msgstr "заблокированы"

msgid "Select regions and countries to add as rules. According to the current rule mode they will be %verb. Existing rules are skipped."
msgstr "Выберите области и страны для добавления в правила. В соответствии с текущим режимом они будут %verb. Существующие правила не дублируются."

msgid "Russian regions (@count)"
msgstr "Области России (@count)"

msgid "Regions"
msgstr "Области"

msgid "Countries"
msgstr "Страны"

msgid "Select all regions"
msgstr "Выбрать все области"

