# --- Module info ---

msgid "IP Anti Spam"
msgstr "IP Anti Spam (защита от спама)"

msgid "Blocks access to the site by IP, country and Russian regions. Includes bot exceptions (Yandex, Google), rule management and visit/block statistics."
msgstr "Блокирует доступ к сайту по IP, странам и областям России. Включает исключения для ботов (Яндекс, Google), управление правилами и статистику переходов и блокировок."

msgid "Custom"
msgstr "Кастомные"

# --- Help (yu_ipas.module) ---

msgid "IP Anti Spam blocks access to the site by IP address, country and Russian regions (GeoLite2-City database). Trusted bots (Yandex, Google) can be excluded via reverse DNS verification. All pages live under <a href=\":url\">IP Anti Spam</a>."
msgstr "IP Anti Spam блокирует доступ к сайту по IP-адресу, стране и областям России (база GeoLite2-City). Доверенные боты (Яндекс, Google) могут быть исключены через проверку по обратному DNS. Все страницы модуля находятся в разделе <a href=\":url\">IP Anti Spam</a>."

# --- Permissions ---

msgid "Administer IP Anti Spam"
msgstr "Управление IP Anti Spam"

msgid "Configure blocking rules, exceptions and view statistics."
msgstr "Настройка правил блокировки, исключений и просмотр статистики."

msgid "Bypass IP Anti Spam blocking"
msgstr "Обход блокировки IP Anti Spam"

msgid "Never blocked by IP Anti Spam rules, regardless of IP."
msgstr "Никогда не блокируется правилами IP Anti Spam, независимо от IP."

# --- Menu and tabs (links.menu.yml, links.task.yml) ---

msgid "Blocking by IP, countries and Russian regions. Rules, exceptions and statistics."
msgstr "Блокировка по IP, странам и областям России. Правила, исключения и статистика."

msgid "Rules"
msgstr "Правила"

msgid "Block/allow rules grouped by countries and Russian regions."
msgstr "Правила блокировки/разрешения, сгруппированные по странам и областям России."

msgid "Exceptions"
msgstr "Исключения"

msgid "Trusted IPs, CIDR ranges and bot User-Agents."
msgstr "Доверенные IP, CIDR-диапазоны и User-Agent ботов."

msgid "Settings"
msgstr "Настройки"

msgid "Module settings: mode, GeoIP database, logging."
msgstr "Настройки модуля: режим, база GeoIP, ведение лога."

msgid "Statistics"
msgstr "Статистика"

msgid "Add rule"
msgstr "Добавить правило"

msgid "Bulk import"
msgstr "Массовый импорт"

msgid "Add exception"
msgstr "Добавить исключение"

# --- SettingsForm ---

msgid "GeoLite2-City database is available at @path."
msgstr "База GeoLite2-City доступна: @path."

msgid "GeoLite2-City database not found or the maxmind-db/reader library is missing. Run <code>drush yu-ipas:download-db</code> or press \"Download database now\" below. Until then only manual IP/CIDR rules will work; country/region rules cannot be evaluated."
msgstr "База GeoLite2-City не найдена или отсутствует библиотека maxmind-db/reader. Выполните <code>drush yu-ipas:download-db</code> или нажмите «Скачать базу сейчас» ниже. Пока будут работать только ручные правила IP/CIDR; правила по странам и областям применяться не могут."

msgid "Enable blocking"
msgstr "Включить блокировку"

msgid "When disabled the module only collects statistics and never blocks requests."
msgstr "Когда выключено, модуль только собирает статистику и никогда не блокирует запросы."

msgid "Rule mode"
msgstr "Режим правил"

msgid "<strong>Blacklist:</strong> listed countries and Russian regions are blocked, everything else is allowed.<br><strong>Whitelist:</strong> only listed Russian regions / countries (and manual IPs) are allowed, everything else is blocked. Trusted bot exceptions apply in both modes."
msgstr "<strong>Чёрный список:</strong> перечисленные страны и области России блокируются, всё остальное разрешено.<br><strong>Белый список:</strong> разрешены только перечисленные области России / страны (и ручные IP), всё остальное блокируется. Исключения для доверенных ботов действуют в обоих режимах."

msgid "Blacklist — block the selected countries/regions"
msgstr "Чёрный список — блокировать выбранные страны/области"

msgid "Whitelist — allow only the selected Russian regions"
msgstr "Белый список — разрешать только выбранные области России"

msgid "GeoIP database (MaxMind GeoLite2-City)"
msgstr "База GeoIP (MaxMind GeoLite2-City)"

msgid "Path to GeoLite2-City.mmdb"
msgstr "Путь к GeoLite2-City.mmdb"

msgid "Stream wrapper path, e.g. private://yu_ipas/GeoLite2-City.mmdb."
msgstr "Путь в формате stream wrapper, например private://yu_ipas/GeoLite2-City.mmdb."

msgid "MaxMind license key"
msgstr "Лицензионный ключ MaxMind"

msgid "Free key from maxmind.com. Only needed for the official \"MaxMind\" source; mirrors work without registration. Prefer the MAXMIND_LICENSE_KEY environment variable on production."
msgstr "Бесплатный ключ с maxmind.com. Нужен только для официального источника «MaxMind»; зеркала работают без регистрации. На продакшене предпочитайте переменную окружения MAXMIND_LICENSE_KEY."

msgid "Logging and statistics"
msgstr "Логирование и статистика"

msgid "Log every passed visit"
msgstr "Логировать каждый разрешённый визит"

msgid "When disabled, only the first visit of each IP per day is logged. Enable only for small/low-traffic sites."
msgstr "Когда выключено, в лог попадает только первый визит каждого IP за день. Включайте только для сайтов с небольшим трафиком."

msgid "Log retention period (days)"
msgstr "Срок хранения лога (дней)"

msgid "Older records are removed on every cron run. 0 disables cleanup."
msgstr "Записи старше указанного срока удаляются при каждом запуске cron. 0 — отключить очистку."

msgid "Trusted bots"
msgstr "Доверенные боты"

msgid "Verify bots by reverse DNS"
msgstr "Проверять ботов по обратному DNS"

msgid "User-Agent exceptions marked as \"verify\" are only trusted when the client IP resolves through forward-confirmed reverse DNS to a known bot network (yandex.ru, googlebot.com, bing.com, etc.). Protects against User-Agent spoofing."
msgstr "Исключения по User-Agent с пометкой «проверять» признаются доверенными только если IP клиента резолвится через forward-confirmed reverse DNS к известной сети ботов (yandex.ru, googlebot.com, bing.com и т.д.). Защита от подмены User-Agent."

msgid "Use a stream wrapper path like private://yu_ipas/GeoLite2-City.mmdb."
msgstr "Используйте путь в формате stream wrapper, например private://yu_ipas/GeoLite2-City.mmdb."

msgid "Invalid mode."
msgstr "Недопустимый режим."

# --- RuleForm ---

msgid "Rule type"
msgstr "Тип правила"

msgid "Single IP address"
msgstr "Отдельный IP-адрес"

msgid "CIDR range (e.g. 192.168.0.0/24)"
msgstr "CIDR-диапазон (например, 192.168.0.0/24)"

