msgstr "<em>Текущий режим: белый список — это правило РАЗРЕШАЕТ выбранное значение, всё остальное будет заблокировано.</em>"

msgid "<em>Current mode: blacklist — this rule BLOCKS the selected value.</em>"
msgstr "<em>Текущий режим: чёрный список — это правило БЛОКИРУЕТ выбранное значение.</em>"

msgid "Save rule"
msgstr "Сохранить правило"

