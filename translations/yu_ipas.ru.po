msgstr "CIDR должен содержать префикс, например 192.168.0.0/24."

msgid "Select a country."
msgstr "Выберите страну."

msgid "Select a Russian region."
msgstr "Выберите область России."

msgid "The rule has been saved."
msgstr "Правило сохранено."

